# .env.ollama — POG2 Sovereign Tier Locker (v2)
# Reality-checked 2026-06-20 against `ollama list`:
#   ACTUAL: gemma4:latest (9.6 GB) only.
#   VRAM:   NVIDIA RTX A1000 6144 MiB (6 GB) — partial CPU offload required
#   RAM:    15 GB total / 14 GB available
#
# Notes:
#   * OLLAMA_NUM_* are read by the Ollama server (truncation floor)
#   * OLLAMA_CTX_*  are read by SovereignConfig/OllamaCapabilityConfig (per-tier)
#   * gemma4 minimum context is 66k; we cap below that to fit 6GB VRAM,
#     and accept that very long contexts will be truncated by Ollama itself.
#
# Tier map:
#   THINK      → Deep reasoning / planning
#   CODE_HEAVY → Heavy code generation (33b class — FALLBACK to gemma4)
#   CODE_MID   → Mid-range code (uses gemma4 — fits with CPU offload)
#   CODE_FAST  → Fast code reflex (7b class — pull qwen2.5-coder:7b for full GPU)
#   FAST       → General fast reflex (<2s)
#   VISION     → Multimodal / image analysis (moondream fallback)

# ── Global Ollama server floor (prevents 3-6 word truncation) ──────
OLLAMA_HOST=0.0.0.0:11434
OLLAMA_NUM_CTX=32768
OLLAMA_NUM_PREDICT=8192
OLLAMA_NUM_GPU=99
OLLAMA_KEEP_ALIVE=30m

# ── THINK (Deep Reasoning) ────────────────────────────────────────
OLLAMA_MODEL_THINK=gemma4:latest
OLLAMA_CTX_THINK=32768

# ── CODE_HEAVY (Executive Code — would be 32B, falls back to gemma4) ─
OLLAMA_MODEL_CODE_HEAVY=gemma4:latest
OLLAMA_CTX_CODE_HEAVY=16384

# ── CODE_MID (Balanced Code — gemma4 with mid context) ────────────
OLLAMA_MODEL_CODE_MID=gemma4:latest
OLLAMA_CTX_CODE_MID=16384

# ── CODE_FAST (Reflex Code — qwen2.5-coder:7b-instruct-q4_K_M, fully fits 6GB VRAM) ─
OLLAMA_MODEL_CODE_FAST=qwen2.5-coder:7b-instruct-q4_K_M
OLLAMA_CTX_CODE_FAST=16384

# ── FAST (General Reflex) ─────────────────────────────────────────
OLLAMA_MODEL_FAST=gemma4:latest
OLLAMA_CTX_FAST=4096

# ── VISION (Multimodal — moondream is tiny, fits fully on GPU) ────
OLLAMA_MODEL_VISION=moondream:latest
OLLAMA_CTX_VISION=2048

# ── Base URL (override if Ollama runs on non-default port) ────────
OLLAMA_BASE_URL=http://localhost:11434

# ── VRAM tier auto-detection (overflow.py reads these) ───────────
#   mini      → 6 GB GPUs  (RTX A1000 Laptop, RTX 3060)
#   puppeteer → 16 GB GPUs (RTX 4080, RTX 5070)
#   pro       → 24 GB GPUs (RTX 4090, A5000)
#   cpu       → no GPU; CPU-only fallback (slow)
#   auto      → detect from `nvidia-smi` at runtime
POG2_VRAM_TIER=auto
# POG2_PYTHON: the python interpreter that runs the overflow shim.
#   - Inside WSL: leave as 'python3' (it can run `nvidia-smi` natively).
#   - From a Windows shell (PowerShell, cmd): leave as 'python3' too —
#     OverflowShim auto-routes through `wsl.exe -e python3` when it detects
#     a Windows python would lose GPU visibility. Set this explicitly only
#     if your ollama + nvidia-smi live somewhere other than the default WSL.
POG2_PYTHON=python3
POG2_OVERFLOW_DEBUG=0
