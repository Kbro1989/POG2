{
  "name": "pog2-cli",
  "version": "1.1.0",
  "description": "POG2 Sovereign CLI — Ternary Intelligence Engine",
  "type": "module",
  "bin": {
    "pog2": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "learn-rsmv": "tsx src/demo_rsmv_learning.ts",
    "ingest-reference": "tsx ingest_full_reference_sets.ts",
    "test-kbd": "tsx src/tests/kbd_roar_cinema.ts",
    "inspect-cache": "tsx inspect_objcache.ts",
    "extract-npc": "tsx extract_npc_raw.ts",
    "extract-item": "tsx extract_item_raw.ts",
    "scan-pog": "tsx scan_cache_for_pog.ts",
    "search-npc": "tsx search_pog_npc_v2.ts",
    "search-major2": "tsx raw_cache_search_major2.ts",
    "get-ids": "tsx get_full_cache_id_list.ts",
    "get-kinematics": "tsx get_kinematics_ids.ts",
    "get-spotanim": "tsx get_spotanim_ids.ts",
    "audit": "powershell -Command \"Get-ChildItem -Recurse -File | Select-Object -ExpandProperty FullName > all_files_audit.txt\"",
    "test": "npm run typecheck && npm run lint",
    "install-global": "npm run build && npm install -g .",
    "prepublishOnly": "npm run build && npm run typecheck"
  },
  "dependencies": {
    "@google-cloud/language": "^6.5.0",
    "@google-cloud/translate": "^8.5.0",
    "@google-cloud/vision": "^4.3.2",
    "@google/genai": "^1.44.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@types/sqlite3": "^3.1.11",
    "better-sqlite3": "^9.4.3",
    "canvas": "^3.2.1",
    "chokidar": "^5.0.0",
    "commander": "^12.1.0",
    "gl": "^8.1.6",
    "googleapis": "^171.4.0",
    "pino": "^9.4.0",
    "pino-pretty": "^13.1.3",
    "puppeteer": "^24.39.1",
    "sqlite3": "^5.0.2",
    "three": "^0.160.0",
    "ts-morph": "^27.0.2",
    "uuid": "^13.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/chokidar": "^1.7.5",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/three": "^0.160.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^7.5.0",
    "@typescript-eslint/parser": "^7.5.0",
    "tar": "^7.5.11",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "**/*",
    "!resources/**/*",
    "!node_modules/**/*",
    "!logs/**/*",
    "!dist/**/*"
  ],
  "keywords": [
    "pog2",
    "sovereign",
    "neurological-ai",
    "autonomous-agent",
    "mcp",
    "vision-intelligence",
    "ternary-routing",
    "orchestration",
    "biomimetic",
    "embeddings",
    "codegen",
    "finops"
  ],
  "preferGlobal": true
}
