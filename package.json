{
  "name": "pog2-cli",
  "version": "1.1.0",
  "description": "POG2 Sovereign CLI — Ternary Intelligence Engine",
  "author": "Kbro1989",
  "license": "MIT",
  "type": "module",
  "bin": {
    "pog2": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "switchboard": "tsx src/switchboard_server.ts",
    "bridge": "tsx src/bridge_server.ts",
    "radar-live": "tsx src/tests/live_radar_experience.ts",
    "combat-demo": "tsx src/tests/combat_grounding_demo.ts",
    "necro-demo": "tsx src/tests/necromancer_ai_demo.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "learn-rsmv": "tsx src/demo_rsmv_learning.ts",
    "ingest-reference": "tsx ingest_full_reference_sets.ts",
    "test-pog": "tsx src/scripts/kbd_roar_cinema.ts",
    "inspect-cache": "tsx inspect_objcache.ts",
    "extract-npc": "tsx extract_npc_raw.ts",
    "extract-item": "tsx extract_item_raw.ts",
    "scan-pog": "tsx scan_cache_for_pog.ts",
    "search-npc": "tsx search_pog_npc_v2.ts",
    "search-major2": "tsx raw_cache_search_major2.ts",
    "get-ids": "tsx get_full_cache_id_list.ts",
    "get-kinematics": "tsx get_kinematics_ids.ts",
    "get-spotanim": "tsx get_spotanim_ids.ts",
    "audit": "powershell -Command \"Get-ChildItem -Recurse -File | Select-Object -ExpandProperty FullName > all_files_audit.txt\"",
    "test": "npm run typecheck && npm run lint",
    "install-global": "npm run build && npm install -g .",
    "prepublishOnly": "npm run build && npm run typecheck"
  },
  "dependencies": {
    "@babylonjs/core": "^9.7.0",
    "@google-cloud/language": "^6.5.0",
    "@google-cloud/translate": "^8.5.0",
    "@google-cloud/vision": "^4.3.2",
    "@google/genai": "^1.44.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@types/sql.js": "^1.4.11",
    "assert": "^2.1.0",
    "autobind-decorator": "^2.4.0",
    "better-sqlite3": "^12.9.0",
    "buffer": "^6.0.3",
    "canvas": "^3.2.1",
    "chokidar": "^5.0.0",
    "classnames": "^2.5.1",
    "cmd-ts": "^0.15.0",
    "commander": "^12.1.0",
    "comment-json": "^4.6.2",
    "dotenv": "^17.4.2",
    "g": "^2.0.1",
    "gl": "^8.1.6",
    "googleapis": "^171.4.0",
    "json-stringify-pretty-compact": "^4.0.0",
    "lzma": "^2.3.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "process": "^0.11.10",
    "punycode": "^2.3.1",
    "puppeteer": "^24.39.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "simple-git": "^3.36.0",
    "sql.js": "^1.14.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "stream-browserify": "^3.0.0",
    "three": "^0.160.1",
    "ts-morph": "^27.0.2",
    "undici": "^8.1.0",
    "util": "^0.12.5",
    "uuid": "^13.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260526.1",
    "@types/autobind-decorator": "^1.3.3",
    "@types/better-sqlite3": "^7.6.11",
    "@types/chokidar": "^1.7.5",
    "@types/classnames": "^2.3.0",
    "@types/express": "^5.0.6",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^22.19.15",
    "@types/node-fetch": "^2.6.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.160.0",
    "@types/uuid": "^10.0.0",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^7.5.0",
    "@typescript-eslint/parser": "^7.5.0",
    "electron": "^41.3.0",
    "idb-keyval": "^6.2.2",
    "json-schema": "^0.4.0",
    "sharp": "^0.34.5",
    "tar": "^7.5.11",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "ws": "^8.21.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "**/*",
    "!resources/**/*",
    "!node_modules/**/*",
    "!logs/**/*",
    "!dist/**/*"
  ],
  "keywords": [
    "pog2",
    "sovereign",
    "neurological-ai",
    "autonomous-agent",
    "mcp",
    "vision-intelligence",
    "ternary-routing",
    "orchestration",
    "biomimetic",
    "embeddings",
    "codegen",
    "finops"
  ],
  "preferGlobal": true,
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "tar": "^7.5.11",
    "uuid": "^13.0.0",
    "copy-webpack-plugin": {
      "serialize-javascript": "^7.0.5"
    },
    "sockjs": {
      "uuid": "^11.1.1"
    }
  }
}
