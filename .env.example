# ==========================================================
# POG2 SOVEREIGN SUBSTRATE â€” ABSOLUTE SOURCE OF TRUTH (EXAMPLE)
# ==========================================================

# --- 1. CLOUDFLARE SUBSTRATE ---
CLOUDFLARE_ACCOUNT_ID=YOUR_ACCOUNT_ID
CLOUDFLARE_API_TOKEN=YOUR_API_TOKEN
CLOUDFLARE_AUTH_EMAIL=YOUR_EMAIL
CLOUDFLARE_IMAGE_ENDPOINT=https://chromanumber-api.YOUR_SUBDOMAIN.workers.dev/ai/generate-image
CLOUDFLARE_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/YOUR_ACCOUNT_ID/pog2-sensory/
CLOUDFLARE_WORKER_URL=https://hello-ai.YOUR_SUBDOMAIN.workers.dev
POG2_GLOBE_ENDPOINT=wss://multiplayer-globe-template.YOUR_SUBDOMAIN.workers.dev/parties/globe/pog2-sovereign

# --- 2. NEURAL SECRETS (GLOBAL) ---
PRIMARY_CLOUD_API_KEY=YOUR_KEY
SECONDARY_CLOUD_API_KEY=YOUR_KEY
HUGGINGFACE_API_KEY=YOUR_KEY
GOOGLE_API_KEY=YOUR_KEY
FIREWORKS_API_KEY=YOUR_KEY
OPENROUTER_API_KEY=YOUR_KEY
GOOGLE_APPLICATION_CREDENTIALS=google-key.json

# --- 3. TIERED PATH SOVEREIGNTY (ANCHORS) ---
POG_PATH_TIER=1
OLLAMA_MODELS_PATH=D:\ollama-models
POG_GUTENBERG_PATH=D:\sovereign\pog-gutenberg
PIPELINE_ROOT=D:\sovereign\pipelines
POG_ERROR_TRACKER_PATH=D:\ollama-models
SOVEREIGN_STORAGE_ROOT=D:\sovereign
SOVEREIGN_LEARNING_DB=D:\sovereign\learning\sovereign-learning.db
POG2_DIR=rsmv\files

# --- 4. GLOBAL SHELL SUBSTRATE ---
GCLOUD_ACTIVE_ACCOUNT=YOUR_EMAIL
WRANGLER_VERSION=4.63.0
GIT_USER_NAME=YOUR_GIT_USERNAME
GIT_USER_EMAIL=YOUR_GIT_EMAIL
SSH_KEY_PRIMARY=C:\Users\YOUR_USERNAME\.ssh\id_rsa
NODE_VERSION=v20.18.0
USER_PROFILE=C:\Users\YOUR_USERNAME

# --- 5. CREATIVE & YOUTUBE SUBSTRATE ---
YOUTUBE_PROJECT_ID=YOUR_PROJECT_ID
YOUTUBE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=YOUR_CLIENT_SECRET
YOUTUBE_API_KEY=YOUR_API_KEY
YOUTUBE_CHANNEL_ID=YOUR_CHANNEL_ID
YOUTUBE_YOUTUBE_ID=YOUR_YOUTUBE_ID
YOUTUBE_REDIRECT_URI=https://chromanumber-auth.YOUR_SUBDOMAIN.workers.dev/youtube/callback
YOUTUBE_TOKEN_PATH=D:\sovereign\youtube_token.json
CHROMANUMBER_AUTH_WORKER=https://chromanumber-auth.YOUR_SUBDOMAIN.workers.dev

# --- 6. POG2 COGNITIVE & ENGINE FLAGS ---
POG_LOG_LEVEL=info
POG2_LOG_PRETTY=1
POG2_AUTO_PROCEED=1
POG_USE_LOCAL=false
SOVEREIGN_MODE=hybrid

# --- 7. CROSS-PROJECT ANCHORS (OPENRSC / DB) ---
OPENRSC_ROOT=OpenRSC
OPENDB_LOCAL_URL=mysql://localhost:3306/openrsc
OPENDB_PRODUCTION_URL=cf://d1-openrsc-prod

# --- 8. NEURAL MODEL OVERRIDES ---
GEMINI_FLASH_MODEL=gemini-1.5-flash
GEMINI_PRO_MODEL=gemini-1.5-pro
GEMINI_EMBEDDING_MODEL=text-embedding-004
OLLAMA_BASE_URL=http://localhost:11434

# --- 9. NEURAL MODEL DEFINITIONS ---
PLANNING_MODEL=kimi-k2-thinking:cloud
CODING_MODEL=qwen2.5-coder:14b-instruct-q5_K_M
ORCHESTRATOR_MODEL=kimi-k2-thinking:cloud
VISION_MODEL=moondream:latest
VOICE_MODEL=gemma4:26b
CODING_HEAVY_MODEL=qwen2.5-coder:14b-instruct-q5_K_M
CODING_FAST_MODEL=qwen2.5-coder:7b-instruct-q4_K_M
EMBEDDING_MODEL=qwen3-embedding:latest
CRITIC_MODEL=kimi-k2-thinking:cloud
LIGHT_AUDITOR_MODEL=all-minilm:latest
MASTER_REASONING_MODEL=kimi-k2-thinking:cloud
MASTER_FALLBACK_MODEL=huggingface:openai-compat/kimi-k2.5-thinking
MASTER_LOCAL_MODEL=deepseek-r1:8b
EXECUTIVE_CODER_MODEL=qwen2.5-coder:14b-instruct-q5_K_M
REACTIVE_AGENT_MODEL=vibethinker:1.5b-q5_K_M
IMAGE_GEN_MODEL=cloudflare:@cf/stabilityai/stable-diffusion-xl-base-1.0
HUGGINGFACE_FALLBACK_MODEL=huggingface:openai-compat/kimi-k2.5-thinking
LOCAL_FALLBACK_MODEL=deepseek-r1:8b

# --- 10. ADVANCED MODEL PARAMETERS ---
PROJECT_ID=global
EMBEDDING_DIMENSIONS=768
WS_PORT=-1
CONTEXT_WINDOW=16384
TEMPERATURE=0.7
TOP_P=0.9
REPEAT_PENALTY=1.1
NUM_CTX=16384
STOP_SEQUENCES=["USER:"]
OUTPUT_FORMAT=json
