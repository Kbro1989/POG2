export class WikiEquipmentEnricher {
    private static instance: WikiEquipmentEnricher;

    private readonly API_BASE = 'https://runescape.wiki/api.php';
    private readonly USER_AGENT = 'POG2-Sovereign/1.0 (Sovereign Research Node; admin@pog2.internal; respectful-soft-parse; +https://github.com/Kbro1989/POG2)';
    private readonly RATE_LIMIT_MS = 1500;
    private readonly CACHE_DIR: string;
    private readonly CACHE_TTL_MS = 7 * 24 * 60 * 60 * 1000; // 7 days

    private lastRequestTime = 0;
    private requestCount = 0;

    private constructor() {
        this.CACHE_DIR = join('D:', 'sovereign', 'atlas', 'wiki', 'cache');
        this.ensureCacheDir();
    }

    public static getInstance(): WikiEquipmentEnricher {
        if (!this.instance) {
            this.instance = new WikiEquipmentEnricher();
        }
        return this.instance;
    }

    // ── Cache Layer ────────────────────────────────────────

    private ensureCacheDir(): void {
        const dirs = [
            this.CACHE_DIR,
            join(this.CACHE_DIR, 'items'),
            join(this.CACHE_DIR, 'monsters'),
            join(this.CACHE_DIR, 'templates'),
            join(this.CACHE_DIR, 'wikitext'),
            join(this.CACHE_DIR, 'generic')
        ];
        for (const dir of dirs) {
            if (!existsSync(dir)) {
                mkdirSync(dir, { recursive: true });
            }
        }
    }

    private sanitizeFilename(name: string): string {
        return name.replace(/[<>:"/\\|?*]/g, '_').replace(/\s+/g, '_').toLowerCase();
    }

    private readCache(subdir: string, key: string): any | null {
        const filePath = join(this.CACHE_DIR, subdir, `${this.sanitizeFilename(key)}.json`);
        if (!existsSync(filePath)) return null;

        try {
            const raw = readFileSync(filePath, 'utf8');
            const cached = JSON.parse(raw);

            // TTL check
            if (cached._cachedAt && (Date.now() - cached._cachedAt) > this.CACHE_TTL_MS) {
                logger.debug({ key }, 'Cache expired, will re-fetch.');
                return null;
            }

            return cached;
        } catch {
            return null;
        }
    }

    private writeCache(subdir: string, key: string, data: any): void {
        const filePath = join(this.CACHE_DIR, subdir, `${this.sanitizeFilename(key)}.json`);
        try {
            writeFileSync(filePath, JSON.stringify({ ...data, _cachedAt: Date.now() }, null, 2), 'utf8');
        } catch (err) {
            logger.warn({ key, err }, 'Failed to write cache.');
        }
    }

    // ── Rate Limiter ───────────────────────────────────────

    private async throttle(): Promise<void> {
        const now = Date.now();
        const elapsed = now - this.lastRequestTime;
        if (elapsed < this.RATE_LIMIT_MS) {
            const delay = this.RATE_LIMIT_MS - elapsed;
            await new Promise(resolve => setTimeout(resolve, delay));
        }
        this.lastRequestTime = Date.now();
        this.requestCount++;
    }

    // ── API Layer ──────────────────────────────────────────

    /**
     * Fetch raw wikitext for a page. Checks disk cache first.
     */
    private async fetchWikitext(pageTitle: string): Promise<string | null> {
        const cached = this.readCache('wikitext', pageTitle);
        if (cached?.wikitext) {
            logger.debug({ title: pageTitle }, 'Wikitext served from cache.');
            return cached.wikitext;
        }

        await this.throttle();

        const params = new URLSearchParams({
            action: 'parse',
            format: 'json',
            page: pageTitle,
            prop: 'wikitext',
            origin: '*'
        });

        try {
            const response = await fetch(`${this.API_BASE}?${params.toString()}`, {
                headers: {
                    'User-Agent': this.USER_AGENT,
                    'Accept': 'application/json'
                },
                signal: AbortSignal.timeout(10000)
            });

            if (!response.ok) {
                if (response.status === 429) {
                    const retryAfter = response.headers.get('Retry-After');
                    if (retryAfter) {
                        ApiThrottle.getInstance().reportRetryAfter('wiki', parseInt(retryAfter, 10));
                    }
                }
                logger.warn({ title: pageTitle, status: response.status }, 'Wiki API non-OK response.');
                return null;
            }

            const data = await response.json() as any;
            const wikitext = data.parse?.wikitext?.['*'] || null;

            if (wikitext) {
                this.writeCache('wikitext', pageTitle, { wikitext });
                logger.info({ title: pageTitle, length: wikitext.length, request: this.requestCount }, 'Wikitext fetched.');
            }

            return wikitext;
        } catch (err) {
            logger.error({ title: pageTitle, err }, 'Failed to fetch wikitext.');
            return null;
        }
    }

    /**
     * Search for the canonical page title matching a query.
     */
    private async searchPage(query: string): Promise<string | null> {
        await this.throttle();

        const params = new URLSearchParams({
            action: 'query',
            format: 'json',
            list: 'search',
            srsearch: query,
            srlimit: '1',
            origin: '*'
        });

        try {
            const response = await fetch(`${this.API_BASE}?${params.toString()}`, {
                headers: { 'User-Agent': this.USER_AGENT },
                signal: AbortSignal.timeout(10000)
            });

            if (!response.ok) {
                if (response.status === 429) {
                    const retryAfter = response.headers.get('Retry-After');
                    if (retryAfter) {
                        ApiThrottle.getInstance().reportRetryAfter('wiki', parseInt(retryAfter, 10));
                    }
                }
                logger.warn({ query, status: response.status }, 'Wiki search non-OK response.');
                return null;
            }

            const data = await response.json() as any;
            return data.query?.search?.[0]?.title || null;
        } catch (err) {
            logger.error({ query, err }, 'Wiki search failed.');
            return null;
        }
    }

    /**
     * Resolves a name to wikitext. Tries direct fetch, follows redirects, falls back to search.
     */
    private async getWikitextForName(name: string): Promise<string | null> {
        // Try direct page first
        let wikitext = await this.fetchWikitext(name);

        // Follow #REDIRECT if the page is a redirect stub
        if (wikitext && wikitext.trim().startsWith('#REDIRECT')) {
            const redirectMatch = wikitext.match(/\[\[([^\]]+)\]\]/);
            if (redirectMatch) {
                const redirectTarget = redirectMatch[1].trim();
                logger.info({ from: name, to: redirectTarget }, 'Following wiki redirect...');
                wikitext = await this.fetchWikitext(redirectTarget);
            }
        }

        if (!wikitext) {
            // Fallback: search for the page
            const title = await this.searchPage(name);
            if (title && title !== name) {
                wikitext = await this.fetchWikitext(title);
                // Follow redirect on search result too
                if (wikitext && wikitext.trim().startsWith('#REDIRECT')) {
                    const redirectMatch = wikitext.match(/\[\[([^\]]+)\]\]/);
                    if (redirectMatch) {
                        const redirectTarget = redirectMatch[1].trim();
                        logger.info({ from: title, to: redirectTarget }, 'Following wiki redirect (search fallback)...');
                        wikitext = await this.fetchWikitext(redirectTarget);
                    }
                }
            }
        }

        return wikitext;
    }

    // ── Template Parser ────────────────────────────────────

    /**
     * Extract a single template's parameters from wikitext.
     * Handles nested templates via bracket-depth tracking.
     */
    private extractTemplate(wikitext: string, templateName: string): Record<string, string> | null {
        const lowerText = wikitext.toLowerCase();
        const lowerName = templateName.toLowerCase();

        let searchIdx = 0;
        let startIdx = -1;

        while (searchIdx < lowerText.length) {
            const bracePos = lowerText.indexOf('{{', searchIdx);
            if (bracePos === -1) break;

            let nameStart = bracePos + 2;
            while (nameStart < lowerText.length && (lowerText[nameStart] === ' ' || lowerText[nameStart] === '\n')) nameStart++;

            if (lowerText.substring(nameStart, nameStart + lowerName.length) === lowerName) {
                const afterName = lowerText[nameStart + lowerName.length];
                if (afterName === '|' || afterName === '}' || afterName === ' ' || afterName === '\n' || afterName === '\r' || afterName === undefined) {
                    startIdx = bracePos;
                    break;
                }
            }
            searchIdx = bracePos + 2;
        }

        if (startIdx === -1) return null;

        // Find matching closing }} using bracket depth
        let depth = 0;
        let endIdx = startIdx;
        for (let i = startIdx; i < wikitext.length - 1; i++) {
            if (wikitext[i] === '{' && wikitext[i + 1] === '{') {
                depth++;
                i++;
            } else if (wikitext[i] === '}' && wikitext[i + 1] === '}') {
                depth--;
                i++;
                if (depth === 0) {
                    endIdx = i + 1;
                    break;
                }
            }
        }

        if (depth !== 0) return null;

        const fullContent = wikitext.substring(startIdx + 2, endIdx - 2);
        const pipeIdx = fullContent.indexOf('|');
        if (pipeIdx === -1) return {};

        return this.parseTemplateParams(fullContent.substring(pipeIdx + 1));
    }

    /**
     * Extract ALL instances of a template from wikitext.
     * Critical for DropsLine parsing where each drop is a separate template call.
     */
    private extractAllTemplateInstances(wikitext: string, templateName: string): Record<string, string>[] {
        const results: Record<string, string>[] = [];
        const lowerText = wikitext.toLowerCase();
        const lowerName = templateName.toLowerCase();
        let searchIdx = 0;

        while (searchIdx < lowerText.length) {
            const bracePos = lowerText.indexOf('{{', searchIdx);
            if (bracePos === -1) break;

            let nameStart = bracePos + 2;
            while (nameStart < lowerText.length && (lowerText[nameStart] === ' ' || lowerText[nameStart] === '\n')) nameStart++;

            if (lowerText.substring(nameStart, nameStart + lowerName.length) === lowerName) {
                const afterName = lowerText[nameStart + lowerName.length];
                if (afterName === '|' || afterName === '}' || afterName === ' ' || afterName === '\n') {
                    // Find closing braces
                    let depth = 0;
                    let endIdx = bracePos;
                    for (let i = bracePos; i < wikitext.length - 1; i++) {
                        if (wikitext[i] === '{' && wikitext[i + 1] === '{') { depth++; i++; }
                        else if (wikitext[i] === '}' && wikitext[i + 1] === '}') {
                            depth--; i++;
                            if (depth === 0) { endIdx = i + 1; break; }
                        }
                    }

                    const fullContent = wikitext.substring(bracePos + 2, endIdx - 2);
                    const pipeIdx = fullContent.indexOf('|');
                    if (pipeIdx !== -1) {
                        results.push(this.parseTemplateParams(fullContent.substring(pipeIdx + 1)));
                    }

                    searchIdx = endIdx;
                    continue;
                }
            }
            searchIdx = bracePos + 2;
        }

        return results;
    }

    /**
     * Parse pipe-separated template parameters, respecting nested template depth.
     * Handles {{nested|templates}} and [[wiki|links]] inside parameter values.
     */
    private parseTemplateParams(text: string): Record<string, string> {
        const params: Record<string, string> = {};
        let depth = 0;
        let currentParam = '';
        let positionalIdx = 1;

        for (let i = 0; i < text.length; i++) {
            const ch = text[i];
            const next = text[i + 1];

            if (ch === '{' && next === '{') { depth++; currentParam += '{{'; i++; }
            else if (ch === '}' && next === '}') { depth--; currentParam += '}}'; i++; }
            else if (ch === '[' && next === '[') { depth++; currentParam += '[['; i++; }
            else if (ch === ']' && next === ']') { depth--; currentParam += ']]'; i++; }
            else if (ch === '|' && depth === 0) {
                this.assignParam(params, currentParam, positionalIdx);
                positionalIdx++;
                currentParam = '';
            } else {
                currentParam += ch;
            }
        }

        // Last parameter
        if (currentParam.trim()) {
            this.assignParam(params, currentParam, positionalIdx);
        }

        return params;
    }

    private assignParam(params: Record<string, string>, raw: string, positionalIdx: number): void {
        const eqIdx = raw.indexOf('=');
        if (eqIdx > 0 && !raw.substring(0, eqIdx).includes('{{')) {
            const key = raw.substring(0, eqIdx).trim().toLowerCase();
            const value = this.cleanWikiMarkup(raw.substring(eqIdx + 1).trim());
            if (key) params[key] = value;
        } else {
            params[`_${positionalIdx}`] = this.cleanWikiMarkup(raw.trim());
        }
    }

    /**
     * Strip wiki markup from a value (links, formatting, refs).
     */
    private cleanWikiMarkup(text: string): string {
        return text
            .replace(/\[\[(?:[^\]|]*\|)?([^\]]*)\]\]/g, '$1')  // [[Link|Text]] -> Text
            .replace(/'''?/g, '')                                // Bold/italic
            .replace(/<ref[^>]*>.*?<\/ref>/gs, '')               // References
            .replace(/<ref[^/]*\/>/g, '')                        // Self-closing refs
            .replace(/<br\s*\/?>/gi, ' ')                        // Line breaks
            .replace(/<!--.*?-->/gs, '')                         // HTML comments
            .replace(/&nbsp;/g, ' ')                             // Non-breaking spaces
            .trim();
    }

    // ── Structured Parsers ─────────────────────────────────

    /**
     * Parse equipment bonuses from an item's wiki page.
     * Tries: Infobox Bonuses, Infobox bonuses, Infobox Bonuses Beta
     */
    public async parseEquipmentBonuses(itemName: string): Promise<WikiEquipmentBonuses | null> {
        const wikitext = await this.getWikitextForName(itemName);
        if (!wikitext) return null;

        const templateNames = ['Infobox Bonuses', 'Infobox bonuses', 'Infobox Bonuses Beta'];
        let bonuses: Record<string, string> | null = null;

        for (const name of templateNames) {
            bonuses = this.extractTemplate(wikitext, name);
            if (bonuses) break;
        }

        if (!bonuses) return null;

        return {
            tier: this.safeInt(bonuses['tier'] || bonuses['level'] || '0'),
            slot: bonuses['slot'] || 'unknown',
            class: bonuses['class'] || bonuses['type'] || 'none',
            style: bonuses['style'] || bonuses['astyle'] || 'none',
            damage: this.safeInt(bonuses['damage'] || bonuses['dmg'] || '0'),
            accuracy: this.safeInt(bonuses['accuracy'] || bonuses['acc'] || '0'),
            armour: this.safeInt(bonuses['armour'] || bonuses['armor'] || bonuses['defence'] || '0'),
            lifeBonus: this.safeInt(bonuses['life'] || bonuses['lp'] || bonuses['lifepoints'] || '0'),
            prayerBonus: this.safeInt(bonuses['prayer'] || '0'),
            attackSpeed: bonuses['speed'] || bonuses['aspeed'] || 'average'
        };
    }

    /**
     * Parse item metadata from an item's wiki page.
     */
    public async parseItemMeta(itemName: string): Promise<WikiItemMeta | null> {
        const wikitext = await this.getWikitextForName(itemName);
        if (!wikitext) return null;

        const info = this.extractTemplate(wikitext, 'Infobox Item')
                   || this.extractTemplate(wikitext, 'Infobox item');
        if (!info) return null;

        return {
            name: info['name'] || itemName,
            examine: info['examine'] || '',
            tradeable: this.safeBool(info['tradeable'] || info['tradable']),
            stackable: this.safeBool(info['stackable']),
            members: this.safeBool(info['members']),
            weight: parseFloat(info['weight'] || '0') || 0,
            highAlch: this.safeInt(info['high'] || info['highalch'] || '0'),
            lowAlch: this.safeInt(info['low'] || info['lowalch'] || '0'),
            // ge field: Grand Exchange mid-price (or ge_sell, exchange, value)
            geValue: this.safeInt(info['ge'] || info['exchange'] || info['ge_buy'] || info['value'] || '0'),
            quest: info['quest'] || 'No',
            release: info['release'] || 'Unknown'
        };
    }

