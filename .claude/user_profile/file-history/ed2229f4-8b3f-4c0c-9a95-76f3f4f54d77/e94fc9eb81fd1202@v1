# .env.ollama — POG2 Sovereign Tier Locker
# Capability-aware local model routing via Ollama (localhost:11434)
# Load order: loaded automatically by SovereignConfig.loadConfig()
#
# Tier map:
#   THINK      → Deep reasoning / planning (large, slow)
#   CODE_HEAVY → Heavy code generation (33b class)
#   CODE_MID   → Mid-range code (14b class)
#   CODE_FAST  → Fast code reflex (7b class)
#   FAST       → General fast reflex (small, <2s)
#   VISION     → Multimodal / image analysis

# ── THINK (Deep Reasoning) ────────────────────────────────────────
OLLAMA_MODEL_THINK=qwen3.6:latest
OLLAMA_CTX_THINK=32768

# ── CODE_HEAVY (Executive Code — 33B, requires ~24GB VRAM) ────────
OLLAMA_MODEL_CODE_HEAVY=deepseek-r1:32b
OLLAMA_CTX_CODE_HEAVY=16384

# ── CODE_MID (Balanced Code — 14B) ───────────────────────────────
OLLAMA_MODEL_CODE_MID=qwen2.5-coder:14b-instruct-q5_K_M
OLLAMA_CTX_CODE_MID=32768

# ── CODE_FAST (Reflex Code — 7B) ─────────────────────────────────
OLLAMA_MODEL_CODE_FAST=qwen2.5-coder:7b-instruct-q4_K_M
OLLAMA_CTX_CODE_FAST=16384

# ── FAST (General Reflex) ─────────────────────────────────────────
OLLAMA_MODEL_FAST=deepseek-r1:8b
OLLAMA_CTX_FAST=8192

# ── VISION (Multimodal) ───────────────────────────────────────────
OLLAMA_MODEL_VISION=gemma4:26b
OLLAMA_CTX_VISION=4096

# ── Base URL (override if Ollama runs on non-default port) ────────
OLLAMA_BASE_URL=http://localhost:11434
