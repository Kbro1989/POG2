/**
 * BestiaryApi.ts
 *
 * High-fidelity interface for the Official RuneScape Bestiary.
 * Provides authoritative monster statistics, weaknesses, and spawn data.
 *
 * Endpoint: http://services.runescape.com/m=itemdb_rs/bestiary
 */

import { ApiThrottle } from './ApiThrottle.js';
import { createLogger } from './logger.js';

const logger = createLogger('BestiaryApi');
const BESTIARY_BASE = 'http://services.runescape.com/m=itemdb_rs/bestiary';

export interface BestiaryBeastData {
    id: number;
    name: string;
    examine: string;
    combatLevel: number;
    lifepoints: number;
    attack: number;
    defence: number;
    magic: number;
    ranged: number;
    weakness: string;
    slayerLevel: number;
    slayerCategory: string;
    size: number;
    aggressive: boolean;
    poisonous: boolean;
    areas: string[];
    animations: Record<string, any>;
    members: boolean;
    xp: number;
}

export interface BestiarySearchEntry {
    value: number; // The beast ID
    label: string; // The beast name (often includes level in parens)
}

export class BestiaryApi {
    private static throttle = ApiThrottle.getInstance();
    private static weaknessMap: Record<string, number> | null = null;

    /**
     * Fetches the canonical mapping of weakness names to IDs.
     * Cached for the duration of the session.
     */
    public static async fetchWeaknessNames(): Promise<Record<string, number>> {
        if (this.weaknessMap) return this.weaknessMap;

        await this.throttle.acquire('bestiary');
        try {
            const res = await fetch(`${BESTIARY_BASE}/weaknessNames.json`, {
                headers: { 'User-Agent': 'POG2-Sovereign/1.0' },
                signal: AbortSignal.timeout(10000)
            });
            if (!res.ok) throw new Error(`Weakness fetch failed: ${res.status}`);
            this.weaknessMap = await res.json() as Record<string, number>;
            return this.weaknessMap;
        } catch (err) {
            logger.error({ err }, 'Failed to fetch weakness names.');
            return {};
        }
    }

    /**
     * Search for beasts by name/term.
     * @param term Search term (e.g., "Cow"). Supports multiple terms separated by '+'.
     */
    public static async searchBeasts(term: string): Promise<BestiarySearchEntry[]> {
        await this.throttle.acquire('bestiary');
        try {
            const url = `${BESTIARY_BASE}/beastSearch.json?term=${encodeURIComponent(term)}`;
            const res = await fetch(url, {
                headers: { 'User-Agent': 'POG2-Sovereign/1.0' },
                signal: AbortSignal.timeout(10000)
            });
            if (!res.ok) return [];
            return await res.json() as BestiarySearchEntry[];
        } catch (err) {
            logger.error({ term, err }, 'Beast search failed.');
            return [];
        }
    }

    /**
     * Fetch authoritative beast data by official ID.
     * @param beastId The canonical RS3 Beast ID.
     */
    public static async getBeastData(beastId: number): Promise<BestiaryBeastData | null> {
        await this.throttle.acquire('bestiary');

        const url = `${BESTIARY_BASE}/beastData.json?beastid=${beastId}`;
        try {
            const res = await fetch(url, {
                headers: { 'User-Agent': 'POG2-Sovereign/1.0' },
                signal: AbortSignal.timeout(10000)
            });

            if (!res.ok) {
                logger.warn({ beastId, status: res.status }, 'Bestiary API non-OK response.');
                return null;
            }

            const data = await res.json() as any;
            if (!data) return null;

            return {
                id: data.id,
                name: data.name,
                examine: data.description,
                combatLevel: data.level,
                lifepoints: data.lifepoints,
                attack: data.attack,
                defence: data.defence,
                magic: data.magic,
                ranged: data.ranged,
                weakness: data.weakness,
                slayerLevel: data.slayerlevel,
                slayerCategory: data.slayercat,
                size: data.size,
                aggressive: data.aggressive,
                poisonous: data.poisonous,
                areas: Array.isArray(data.areas) ? data.areas : [],
                animations: data.animations || {},
                members: data.members === 'true' || data.members === true,
                xp: parseFloat(data.xp || '0'),
            };
        } catch (err) {
            logger.error({ beastId, err }, 'Failed to fetch beast data.');
            return null;
        }
    }

    /**
     * Returns a list of all area names present in the Bestiary.
     */
    public static async getAreaNames(): Promise<string[]> {
        await this.throttle.acquire('bestiary');
        try {
            const res = await fetch(`${BESTIARY_BASE}/areaNames.json`, {
                headers: { 'User-Agent': 'POG2-Sovereign/1.0' },
                signal: AbortSignal.timeout(10000)
            });
            if (!res.ok) return [];
            return await res.json() as string[];
        } catch (err) {
            logger.error({ err }, 'Failed to fetch area names.');
            return [];
        }
    }

    /**
     * Returns all beasts found in a specific area.
     */
    public static async getBeastsInArea(areaName: string): Promise<BestiarySearchEntry[]> {
        await this.throttle.acquire('bestiary');
        try {
            const url = `${BESTIARY_BASE}/areaBeasts.json?identifier=${encodeURIComponent(areaName)}`;
            const res = await fetch(url, {
                headers: { 'User-Agent': 'POG2-Sovereign/1.0' },
                signal: AbortSignal.timeout(10000)
            });
            if (!res.ok) return [];
            return await res.json() as BestiarySearchEntry[];
        } catch (err) {
            logger.error({ areaName, err }, 'Failed to fetch beasts in area.');
            return [];
        }
    }

    /**
     * Returns a mapping of Slayer category names to their IDs.
     */
    public static async getSlayerCategories(): Promise<Record<string, number>> {
        await this.throttle.acquire('bestiary');
        try {
            const res = await fetch(`${BESTIARY_BASE}/slayerCatNames.json`, {
                headers: { 'User-Agent': 'POG2-Sovereign/1.0' },
                signal: AbortSignal.timeout(10000)
            });
            if (!res.ok) return {};
            return await res.json() as Record<string, number>;
        } catch (err) {
            logger.error({ err }, 'Failed to fetch slayer categories.');
            return {};
        }
    }

    /**
     * Returns monsters within a specific slayer category.
     */
    public static async getBeastsInSlayerCategory(catId: number): Promise<BestiarySearchEntry[]> {
        await this.throttle.acquire('bestiary');
        try {
            const url = `${BESTIARY_BASE}/slayerBeasts.json?identifier=${catId}`;
            const res = await fetch(url, {
                headers: { 'User-Agent': 'POG2-Sovereign/1.0' },
                signal: AbortSignal.timeout(10000)
            });
            if (!res.ok) return [];
            return await res.json() as BestiarySearchEntry[];
        } catch (err) {
            logger.error({ catId, err }, 'Failed to fetch beasts in slayer category.');
            return [];
        }
    }

    /**
     * Returns monsters with a specific weakness.
     */
    public static async getBeastsWithWeakness(weaknessId: number): Promise<BestiarySearchEntry[]> {
        await this.throttle.acquire('bestiary');
        try {
            const url = `${BESTIARY_BASE}/weaknessBeasts.json?identifier=${weaknessId}`;
            const res = await fetch(url, {
                headers: { 'User-Agent': 'POG2-Sovereign/1.0' },
                signal: AbortSignal.timeout(10000)
            });
            if (!res.ok) return [];
            return await res.json() as BestiarySearchEntry[];
        } catch (err) {
            logger.error({ weaknessId, err }, 'Failed to fetch beasts with weakness.');
            return [];
        }
    }

    /**
     * Returns monsters within a combat level range.
     */
    public static async getBeastsInLevelRange(min: number, max: number): Promise<BestiarySearchEntry[]> {
        await this.throttle.acquire('bestiary');
        try {
            const url = `${BESTIARY_BASE}/levelGroup.json?identifier=${min}-${max}`;
            const res = await fetch(url, {
                headers: { 'User-Agent': 'POG2-Sovereign/1.0' },
                signal: AbortSignal.timeout(10000)
            });
            if (!res.ok) return [];
            return await res.json() as BestiarySearchEntry[];
        } catch (err) {
            logger.error({ min, max, err }, 'Failed to fetch beasts in level range.');
            return [];
        }
    }

    /**
     * Returns all monsters whose names start with a specific letter.
     */
    public static async getBeastsByLetter(letter: string): Promise<any[]> {
        await this.throttle.acquire('bestiary');
        try {
            const url = `${BESTIARY_BASE}/bestiaryNames.json?letter=${encodeURIComponent(letter)}`;
            const res = await fetch(url, {
                headers: { 'User-Agent': 'POG2-Sovereign/1.0' },
                signal: AbortSignal.timeout(10000)
            });
            if (!res.ok) return [];
            return await res.json() as any[];
        } catch (err) {
            logger.error({ letter, err }, 'Failed to fetch beasts by letter.');
            return [];
        }
    }
}
