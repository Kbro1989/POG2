    "uint8": { "type": "number", "size": 1, "signed": false, "readMethod": "readUInt8" },
    "int16": { "type": "number", "size": 2, "signed": true, "readMethod": "readInt16BE" },
    "uint16": { "type": "number", "size": 2, "signed": false, "readMethod": "readUInt16BE" },
    "int32": { "type": "number", "size": 4, "signed": true, "readMethod": "readInt32BE" },
    "uint32": { "type": "number", "size": 4, "signed": false, "readMethod": "readUInt32BE" },
    "float32": { "type": "number", "size": 4, "float": true, "readMethod": "readFloatBE" }
  }
