{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "./",
    "baseUrl": "./",
    "strict": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "jsx": "react-jsx",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "paths": {
      "*": ["src/*"],
      "rsmv/*": ["src/rsmv/*"]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "resources",
    "logs",
    "src/scripts/**/*",
    "src/scripts_backup/**/*",
    "src/tests/**/*",
    "src/tests_backup/**/*",
    "../src_rsmv/**/*",
    "D:/src_rsmv/**/*"
  ]
}