{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "jsx": "react-jsx"
  },
  "include": [
    "src/**/*",
    "cache_*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "resources",
    "logs",
    "src/rsmv",
    "src/rsmv/**",
    "src/scripts_backup",
    "src/tests_backup"
  ],
  "references": [
    { "path": "./src/rsmv" }
  ]
}