{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true
  },
  "include": [
    "src/**/*",
    "cache_*.ts",
    "tmp_rsmv_inspect/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "resources",
    "logs"
  ]
}